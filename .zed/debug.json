[
  {
    "type": "python",
    "request": "launch",
    "name": "Validate setup",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "program": "${workspaceFolder}/scripts/validate_exploration_themes_setup.py",
    "console": "integratedTerminal",
  },
  {
    "type": "python",
    "request": "launch",
    "name": "Create Typesense collection",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "program": "${workspaceFolder}/scripts/create_exploration_themes_collection.py",
    "console": "integratedTerminal",
  },
  {
    "type": "python",
    "request": "launch",
    "name": "Expand 1 theme",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "module": "pipelines.exploration_themes.main_adhoc",
    "args": ["--mode", "expand", "--expand-count", "1"],
    "console": "integratedTerminal",
  },
  {
    "type": "python",
    "request": "launch",
    "name": "Expand 5 themes",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "module": "pipelines.exploration_themes.main_adhoc",
    "args": ["--mode", "expand", "--expand-count", "5"],
    "console": "integratedTerminal",
  },
  {
    "type": "python",
    "request": "launch",
    "name": "Refresh all themes (dry-run)",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "module": "pipelines.exploration_themes.main_adhoc",
    "args": ["--mode", "refresh", "--dry-run"],
    "console": "integratedTerminal",
  },
  {
    "type": "python",
    "request": "launch",
    "name": "Refresh one theme (dry-run)",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "module": "pipelines.exploration_themes.main_adhoc",
    "args": [
      "--mode",
      "refresh",
      "--theme-ids",
      "beach-day-with-friends",
      "--dry-run",
    ],
    "console": "integratedTerminal",
  },
  {
    "type": "python",
    "request": "launch",
    "name": "Refresh one theme (write)",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "module": "pipelines.exploration_themes.main_adhoc",
    "args": ["--mode", "refresh", "--theme-ids", "beach-day-with-friends"],
    "console": "integratedTerminal",
  },
  {
    "type": "python",
    "request": "launch",
    "name": "Streamlit QA UI",
    "python": "${workspaceFolder}/.venv/bin/python",
    "cwd": "${workspaceFolder}",
    "module": "streamlit",
    "args": ["run", "${workspaceFolder}/tools/streamlit_themes/app.py"],
    "console": "integratedTerminal",
  },
]
